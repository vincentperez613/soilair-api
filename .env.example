# Copia este archivo como .env SOLO para desarrollo local (.env está en .gitignore).
# En producción las variables se capturan en Vercel -> Project -> Settings ->
# Environment Variables (o con `vercel env add`).

# Puerto local de `npm run dev`. En Vercel no se usa.
PORT=3000

# PostgreSQL (Neon). Usa la cadena "pooled" (el host lleva -pooler) con sslmode=require.
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Llaves VAPID: genéralas con `npm run llaves` y pégalas aquí (local) y en Vercel.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto real del responsable del servidor: mailto:correo o una URL https.
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Origen EXACTO del frontend: esquema + dominio (+ puerto), sin ruta ni "/" final.
# Producción: https://vperez25.github.io   Local (Live Server): http://127.0.0.1:5500
CORS_ORIGIN=http://127.0.0.1:5500
